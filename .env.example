# ==============================================================================
# Tech Jobs Radar — Variáveis de Ambiente (Template Seguro)
# Copie este arquivo para .env e preencha suas credenciais reais.
# NUNCA comite o arquivo .env no repositório Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ingestão Resiliente — SerpApi (Google Jobs Engine)
# Obtenha sua chave gratuita em: https://serpapi.com/
# ------------------------------------------------------------------------------
SERPAPI_API_KEY="sua_chave_serpapi_aqui"

# ------------------------------------------------------------------------------
# 2. Notificador — Telegram Bot API
# Crie seu bot com @BotFather e obtenha seu Chat ID com @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="seu_token_telegram_bot_aqui"
TELEGRAM_CHAT_ID="seu_chat_id_aqui"

# ------------------------------------------------------------------------------
# 3. Inteligência Artificial & NLP — Google Gemini API
# Obtenha sua chave gratuita em: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY="sua_chave_gemini_api_aqui"

# ------------------------------------------------------------------------------
# 4. Configurações Operacionais de Execução
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DATA_LAKE_BASE_PATH="./data"
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=5
